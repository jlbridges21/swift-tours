# Project URL — Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key — Supabase Dashboard → Project Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — Supabase Dashboard → Project Settings → API → Project API keys → service_role (server-only; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical public site origin used in share/embed snippets (no trailing slash).
# Set this to your custom domain in production so iframes and /embed.js URLs stay correct.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Staging workers use SUPABASE_SERVICE_ROLE_KEY via lib/supabase/admin.ts (server-only).
# Do not prefix the service role key with NEXT_PUBLIC_.

# ── AI staging (server-only; never NEXT_PUBLIC_) ─────────────────────────────
# fal.ai API key for FLUX Fill (https://fal.ai/dashboard/keys)
FAL_KEY=your-fal-key

# Set to 'true' to expose Remove tripod (AI) in the editor and allow job creation.
STAGING_ENABLED=false

# Provider id — currently only fal_flux_fill
STAGING_PROVIDER=fal_flux_fill

# Spend guardrail: max staging_jobs rows per tour (default 50)
STAGING_MAX_JOBS_PER_TOUR=50

# Optional: Part 0 round-trip gate endpoint auth (Bearer token)
# STAGING_GATE_SECRET=